NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lexsahayak
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# AI: mock works without external credentials. Use openai for real LangChain generation.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_INPUT_CHARS=45000
AI_MAX_OUTPUT_TOKENS=1800
AI_DAILY_USER_REQUEST_LIMIT=80
VECTOR_SEARCH_MODE=local
ATLAS_VECTOR_INDEX=legal_vector_index

# Email: console prints verification/reset links locally. Set smtp in production.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LexSahayak AI <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=false

# Uploads
MAX_UPLOAD_MB=8
OCR_MAX_PAGES=5
OCR_LANGUAGE=eng

# Optional admin seed credentials (change before deployment)
SEED_ADMIN_EMAIL=admin@lexsahayak.local
SEED_ADMIN_PASSWORD=Admin123!ChangeMe
